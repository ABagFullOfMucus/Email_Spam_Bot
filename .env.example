# Gmail SMTP credentials
# https://support.google.com/mail/answer/185833
EMAIL=your-email@gmail.com
# Use an App Password, NOT your normal Gmail password
# https://support.google.com/accounts/answer/185833
EMAIL_PASSWORD=your-16-char-app-password

# Recipient(s) — separate multiple addresses with commas:
# TO_EMAIL=one@example.com,two@example.com
TO_EMAIL=recipient@example.com

# Optional settings
# MESSAGE=Email body text (plain text by default)
# SUBJECT=Email subject (default: "Tama bel fee")
# MESSAGE_HTML=<p>HTML body</p> (use alongside MESSAGE for multipart)
#
# Attachments — every file in ATTACHMENTS_DIR is attached automatically.
# Drop images into ./attachments/ and they ship with the next run.
# ATTACHMENTS_DIR=attachments
# MAX_ATTACHMENT_MB=20          # fail fast before connecting (Gmail caps ~25 MB)
# DISABLE_ATTACHMENTS=false     # true = text-only run, ignore the folder
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# USE_TLS=false
# MAX_RETRIES=3
# RETRY_DELAY=2
# USE_DRY_RUN=false